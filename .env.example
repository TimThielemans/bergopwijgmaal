# Environment configuration for VC Berg-Op Wijgmaal
#
# Copy to `.env` and fill in what you need. The site runs fully without any of
# these values: content then comes from the typed mock modules in `src/content/`
# and the generated JSON in `src/data/`.
# Only VITE_-prefixed variables reach the browser bundle. Never put secrets here.

# --- Sanity CMS (optional until the CMS is connected) ---------------------------
# Project id from sanity.io/manage. Setting this switches the content providers
# to the Sanity source; leaving it empty keeps the mock content.
VITE_SANITY_PROJECT_ID=
# Dataset name. Default: production
VITE_SANITY_DATASET=production
# API version as a date string. Default: 2024-01-01
VITE_SANITY_API_VERSION=2024-01-01
# Absolute URL of the hosted Sanity Studio. It is hosted by Sanity itself, lives
# outside this repository and has no effect on the website build.
# When set, the /admin dashboard deep-links into it.
VITE_SANITY_STUDIO_URL=https://bergop-wijgmaal.sanity.studio
# Use the cached Sanity CDN for read-only queries. Default: true
VITE_SANITY_USE_CDN=true
# Server-only read token (Sanity Viewer role). Required: the project denies
# anonymous reads, so all queries run server-side via src/lib/sanity/fetch.functions.ts.
# Never prefix with VITE_ — this value must not reach the browser.
SANITY_READ_TOKEN=skhghN5iFsb0O6E3f3pXbwRLLYOjA6iBfALCNuWtYDWVmBSQ97rRR7MQaZKt8vofRrcGRm7GkJqIHyohuXs449rT7udjRbYc2kcqqTn5ZUfzTyz0zfrqyY9q21k6XpFwkRZ1LMjTbsnSjNajAEY5cRuxN1rvRS6a8Fn81qp8XE2z9IyZGxV4

# --- Admin / authentication (placeholder flow) ---------------------------------
# Show the small Login link and mount /admin + /login. Default: true
VITE_ADMIN_ENABLED=true
# Future auth provider id, e.g. "sanity" or "oauth". Empty = placeholder login.
VITE_ADMIN_PROVIDER=
# Where to land after a successful sign-in. Default: /admin
VITE_ADMIN_REDIRECT_URL=/admin
